# Placeholders only. Building and running tests does not require loading this file.
GATE_PASSWORD=mock-password
GATE_SECRET=mock-gate-secret-not-for-production
SUPABASE_URL=https://example.invalid
SUPABASE_PUBLISHABLE_KEY=mock-publishable-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key
# Server only: project's accepted HS256 signing secret, not the API/service-role key.
SUPABASE_JWT_SECRET=mock-collector-signing-secret-not-for-production
# Optional: only for projects requiring a signing key id.
SUPABASE_JWT_KID=

# WhatsApp Cloud API (server only). Use Meta's Phone Number ID for Graph and the
# international display number for wa.me. Set an HTTPS origin you control.
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_BUSINESS_NUMBER=15555550100
WHATSAPP_ACCESS_TOKEN=mock-meta-access-token
WHATSAPP_VERIFY_TOKEN=mock-webhook-verification-token
WHATSAPP_APP_SECRET=mock-meta-app-secret
WHATSAPP_APP_ORIGIN=https://example.invalid
# Vercel daily pending-order reminder. Leave the template unset until approved.
CRON_SECRET=mock-cron-secret-not-for-production
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_REMINDER_LANGUAGE=en_US

# Chat: request OIDC, then environment OIDC, then the API key. Unset OIDC for local API-key auth.
# Optional. Leave unset to use the default model and fallbacks in src/lib/ai-gateway.server.ts.
# AI_GATEWAY_MODEL=openai/gpt-6.2-sol
AI_GATEWAY_API_KEY=mock-key
VERCEL_OIDC_TOKEN=mock-oidc-token

# Server-side price providers and web lookups
EBAY_CLIENT_ID=mock-client-id
EBAY_CLIENT_SECRET=mock-client-secret
APIFY_TOKEN=mock-token
SILPHCO_API_KEY=mock-key
TELEM_API_KEY=mock-key

# Collectr background sync and WhatsApp link/payment signing (separate derived keys; at least 32 characters)
HR_API_KEY=mock-key
MORI_MCP_SECRET=mock-collectr-signing-secret-not-for-production
